# ==============================================================================
# AWS LocalStack & Cloud Configuration
# ==============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# S3, DynamoDB, and SQS Resources
S3_RAW_EVENTS_BUCKET=salesforce-raw-events
S3_BACKUPS_BUCKET=salesforce-backups
DYNAMODB_TABLE_NAME=SalesforceSyncRecords
SQS_INBOUND_QUEUE_NAME=salesforce-inbound-queue
SQS_DLQ_NAME=salesforce-deadletter-queue

# ==============================================================================
# MySQL Database (Multi-User Sessions, OAuth Tokens & Expiration Management)
# ==============================================================================
# Host port mapping: 3307 avoids conflicts with existing local MySQL servers on 3306
MYSQL_HOST_PORT=3307
MYSQL_HOST=mysql-db
MYSQL_PORT=3306
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DATABASE=salesforce_integration
MYSQL_ROOT_PASSWORD=root_password

# ==============================================================================
# SALESFORCE OAUTH 2.0 AUTHORIZATION CODE FLOW CONFIGURATION
# ==============================================================================
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=your_connected_app_consumer_key
SALESFORCE_CLIENT_SECRET=your_connected_app_consumer_secret
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/auth/salesforce/callback

SALESFORCE_API_VERSION=v58.0
SALESFORCE_SCOPES=api refresh_token offline_access
FRONTEND_REDIRECT_URL=http://localhost:3000

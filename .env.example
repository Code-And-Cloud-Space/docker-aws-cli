# ==============================================================================
# AWS LocalStack & Cloud Configuration
# ==============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# S3, DynamoDB, and SQS Resources
S3_RAW_EVENTS_BUCKET=salesforce-raw-events
S3_BACKUPS_BUCKET=salesforce-backups
DYNAMODB_TABLE_NAME=SalesforceSyncRecords
SQS_INBOUND_QUEUE_NAME=salesforce-inbound-queue
SQS_DLQ_NAME=salesforce-deadletter-queue

# ==============================================================================
# LIVE SALESFORCE CONFIGURATION
# ==============================================================================
# Authentication Type: 'oauth_password' or 'access_token'
SALESFORCE_AUTH_TYPE=oauth_password

# Salesforce Login Endpoint:
# - Production / Developer Org: https://login.salesforce.com
# - Sandbox Org: https://test.salesforce.com
# - Custom Domain: https://yourcompany.my.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# 1. For 'oauth_password' flow:
SALESFORCE_USERNAME=your_salesforce_username@example.com
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_security_token_if_required
SALESFORCE_CLIENT_ID=your_connected_app_consumer_key
SALESFORCE_CLIENT_SECRET=your_connected_app_consumer_secret

# 2. For 'access_token' flow (direct token / session id):
# SALESFORCE_INSTANCE_URL=https://yourcompany.my.salesforce.com
# SALESFORCE_ACCESS_TOKEN=00D5g00000XyZ1!AQEAQ...

# Salesforce REST API Version
SALESFORCE_API_VERSION=v58.0
